# ═══════════════════════════════════════════════════════════════════
# PudimFinance — LAN server deployment configuration
#
# Usage (do not overwrite the root .env used by scripts/run.sh):
#   docker compose --env-file .env.docker up --build -d
#
# Browsers on the LAN open the web client at http://<PUBLIC_HOST>:<WEB_PORT>
# (same-origin API proxy — no in-app server configuration needed).
# Desktop/Android clients point at the backend via Settings → Server
# (e.g. http://192.168.1.100:3000) — no per-client rebuild is needed.
# ═══════════════════════════════════════════════════════════════════

# ── LAN address ────────────────────────────────────────────────────
# This server's IP/hostname as seen from other devices on the network.
# Find it with: hostname -I   (e.g. 192.168.1.100)
PUBLIC_HOST=192.168.1.100

# ── Host ports ─────────────────────────────────────────────────────
# Defaults match docker-compose.yml. If a port is already used by
# another service, pick a free one. Check with:
#   ss -tlnp | grep -E ':(3000|5173|5432|5672|15672|9090|3001)\b'
WEB_PORT=5173           # Web client (SPA behind nginx)
PG_PORT=5432            # PostgreSQL
RABBIT_PORT=5672        # RabbitMQ AMQP
RABBIT_MGMT_PORT=15672  # RabbitMQ management UI
BACKEND_PORT=3000       # Rust backend API
PROMETHEUS_PORT=9090    # Prometheus
GRAFANA_PORT=3001       # Grafana

# ── Web client API address (build-time) ────────────────────────────
# Leave EMPTY so the SPA calls the backend on the same origin through the nginx
# proxy (works for any device with no setup). Set it to the backend's public URL
# (e.g. http://192.168.1.100:3000) to bake direct API calls instead — that
# requires rebuilding the web image when the address changes.
VITE_API_BASE_URL=

# ── Auth ────────────────────────────────────────────────────────────
# Secret used to sign JWTs (login/register sessions). Change it in
# production — and note that changing it signs everyone out. Generate one
# with:  openssl rand -hex 32
#   JWT_SECRET=dev-secret-change-me-in-production
JWT_SECRET=dev-secret-change-me-in-production

# ── Local development (only used by scripts/run.sh via `source`) ──
# Not consumed by docker compose, but kept here so this file can be
# sourced safely.
DATABASE_URL=postgres://pudim:pudim@localhost:5432/pudimfinance
RABBITMQ_URL=amqp://pudim:pudim@localhost:5672
