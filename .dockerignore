# Keep the repo-root build context small. The `web` service builds with
# `context: .` + `dockerfile: desktop/Dockerfile.web` (see docker-compose.yml),
# so everything here would otherwise be uploaded to the Docker daemon on every
# build.

.git
.github
.gitignore

backend/target/
**/target/

# Tauri native shell — the web client build only needs desktop/src + shared/
# (gen/ is the generated Android project, ~600 MB)
desktop/src-tauri/

**/node_modules/
**/dist/
**/*.tsbuildinfo

# Local environment files — never ship secrets into an image
.env
.env.*
!.env.example
