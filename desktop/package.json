{
  "name": "desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "generate-types": "openapi-typescript ../api/openapi/openapi.json -o src/lib/api-types.ts",
    "icons": "tauri icon src-tauri/icons/icon-manifest.json -o src-tauri/icons",
    "tauri": "tauri",
    "test:offline": "tsx --tsconfig=tsconfig.app.json scripts/offline-smoke.ts",
    "test:widget": "tsx --tsconfig=tsconfig.app.json scripts/widget-smoke.ts",
    "test:qr-scan": "tsx --tsconfig=tsconfig.app.json scripts/qr-scan-smoke.ts",
    "test:android": "tsx --tsconfig=tsconfig.app.json scripts/android-shell-smoke.tsx",
    "test:request-timeout": "tsx --tsconfig=tsconfig.app.json scripts/request-timeout-smoke.ts",
    "test:category-icons": "tsx --tsconfig=tsconfig.app.json scripts/category-icons-smoke.ts"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@tanstack/react-query": "^5.59.0",
    "@tauri-apps/api": "^2.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "tailwind-merge": "^2.5.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^20.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.15.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.47",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.12",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  }
}
