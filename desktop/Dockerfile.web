# ─────────────────────────────────────────────────────────────────────────────
# PudimFinance web client.
#
# Serves the same React frontend as the Tauri desktop app (`desktop/src`) as a
# static SPA behind nginx — this is the "web version" the LAN server publishes
# on `WEB_PORT` (default 5173). It replaces the retired `web/` React SPA.
#
# The build context is the repo root (see docker-compose.yml) because the client
# imports the shared dictionaries/icons through the `@shared` alias → ../shared.
# ─────────────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /repo/desktop

# 1) Manifests first, so the `npm ci` layer stays cached across source edits.
COPY desktop/package.json desktop/package-lock.json ./
RUN npm ci --no-audit --no-fund

# 2) Shared, framework-agnostic modules live outside the client package.
COPY shared/ /repo/shared/

# 3) The client sources (node_modules/dist/src-tauri are excluded by .dockerignore).
COPY desktop/ ./

# VITE_API_BASE_URL is baked into the bundle at build time:
#   empty (default)  → same-origin requests; nginx proxies /api and /health to
#                      the backend, so browsers on the LAN need no setup.
#   http://host:port → the SPA calls that backend directly (CORS is permissive).
ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN npm run build

# ── Runtime: nginx serves the SPA and proxies the API ────────────────────────
FROM nginx:1.27-alpine AS runtime

COPY desktop/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /repo/desktop/dist /usr/share/nginx/html

EXPOSE 80
