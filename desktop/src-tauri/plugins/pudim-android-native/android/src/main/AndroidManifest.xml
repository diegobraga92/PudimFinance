<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Posting the import prompt on Android 13+ requires the runtime opt-in. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!--
          Declared with the BIND_NOTIFICATION_LISTENER_SERVICE permission + intent
          filter, which is what makes this app appear in
          Settings → Special app access → Notification access.
        -->
        <service
            android:name="app.tauri.pudimnative.NotificationListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Handles the income/debit/credit buttons on an import-prompt notification. -->
        <receiver
            android:name="app.tauri.pudimnative.CaptureActionReceiver"
            android:exported="false" />

        <!-- Home-screen spending overview widgets. -->
        <receiver
            android:name="app.tauri.pudimnative.QuickAddWidgetProvider"
            android:label="@string/widget_spending_label_4x2"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quickadd_widget_info" />
        </receiver>
        <receiver
            android:name="app.tauri.pudimnative.QuickAddWidgetWideProvider"
            android:label="@string/widget_spending_label_4x1"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/quickadd_widget_wide_info" />
        </receiver>
        <receiver
            android:name="app.tauri.pudimnative.QuickAddWidgetSmallProvider"
            android:label="@string/widget_spending_label_2x1"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/quickadd_widget_small_info" />
        </receiver>
        <receiver
            android:name="app.tauri.pudimnative.WidgetRefreshReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
