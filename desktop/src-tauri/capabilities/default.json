{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "pudim-native:allow-is-supported",
    "pudim-native:allow-access-granted",
    "pudim-native:allow-open-settings",
    "pudim-native:allow-open-external",
    "pudim-native:allow-google-sign-in",
    "pudim-native:allow-drain-pending",
    "pudim-native:allow-show-capture-prompt",
    "pudim-native:allow-cancel-capture-prompt",
    "pudim-native:allow-drain-capture-actions",
    "pudim-native:allow-notification-posting-allowed",
    "pudim-native:allow-request-notification-permission",
    "pudim-native:allow-set-capture-settings",
    "pudim-native:allow-set-sync-config",
    "pudim-native:allow-sync-outbox-put",
    "pudim-native:allow-sync-outbox-remove",
    "pudim-native:allow-drain-sync-results",
    "pudim-native:allow-clear-sync-outbox",
    "pudim-native:allow-peek-logs",
    "pudim-native:allow-clear-logs",
    "pudim-native:allow-secure-get",
    "pudim-native:allow-secure-set",
    "pudim-native:allow-secure-delete",
    "pudim-native:allow-biometric-available",
    "pudim-native:allow-biometric-authenticate",
    "pudim-native:allow-set-widget-spending",
    "pudim-native:allow-set-widget-theme",
    "pudim-native:allow-take-deep-link",
    "pudim-native:allow-take-auth-redirect",
    "pudim-native:allow-register-listener",
    "pudim-native:allow-remove-listener"
  ]
}
