# PudimFinance environment template
#
# Copy this file once to .env and edit the values for your machine/server:
#   cp .env.example .env
#
# Docker Compose automatically reads the root .env for interpolation, while
# scripts/run.sh sources the same file before starting the local backend. Do
# not commit .env; it is ignored by Git.

# ── LAN address and Docker host ports ───────────────────────────────
# PUBLIC_HOST is documentation-only; clients still configure the backend URL
# in the app (for example, http://192.168.1.100:3000).
PUBLIC_HOST=localhost
WEB_PORT=5173
PG_PORT=5432
RABBIT_PORT=5672
RABBIT_MGMT_PORT=15672
BACKEND_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# ── Web client ──────────────────────────────────────────────────────
# Empty means same-origin through the nginx proxy. Set a public backend URL
# only when intentionally building the web image for direct API calls.
VITE_API_BASE_URL=

# ── Backend local-development connections ───────────────────────────
# Docker Compose uses service-internal URLs for the containerized backend;
# these values are used by scripts/run.sh when running `cargo run` locally.
DATABASE_URL=postgres://pudim:pudim@localhost:5432/pudimfinance
DATABASE_POOL_MAX_CONNECTIONS=10
DATABASE_POOL_ACQUIRE_TIMEOUT_SECS=10
RABBITMQ_URL=amqp://pudim:pudim@localhost:5672
RABBITMQ_MANAGEMENT_URL=http://localhost:15672

# ── Auth ────────────────────────────────────────────────────────────
JWT_SECRET=dev-secret-change-me-in-production
# Public OAuth client IDs accepted by the backend. Include the Android client,
# the Desktop client, and the client configured as androidServerClientId in
# desktop/google-oauth-clients.json. Google OAuth can remain in Testing mode;
# add permitted accounts under Google Cloud → Test users.
GOOGLE_CLIENT_IDS=416078507672-hvo7chlndcefmks9loeigg1kvtueikho.apps.googleusercontent.com,416078507672-tfalhei9jo0954el9demikrs09hsnsid.apps.googleusercontent.com
# Exact client ID paired with the server-only secret below. Set both values only
# in the ignored .env on the deployment server. Leave both unset for secret-less
# public clients; Android Credential Manager does not use a client secret.
# GOOGLE_CLIENT_SECRET_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Backend server and logging ──────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
RUST_LOG=backend=debug,tower_http=debug
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
